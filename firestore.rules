rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Somente o criador do projeto (console) pode atribuir papéis.
    // Não permita ao próprio usuário criar seu documento de admin.
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() &&
        get(/databases/$(database)/documents/roles/$(request.auth.uid)).data.get('admin', false) == true;
    }
    function canScore() {
      return signedIn() && (
        get(/databases/$(database)/documents/roles/$(request.auth.uid)).data.get('admin', false) == true ||
        get(/databases/$(database)/documents/roles/$(request.auth.uid)).data.get('scorer', false) == true
      );
    }
    match /roles/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, create, update, delete: if false;
    }
    match /players/{id} {
      allow read: if true;
      allow create, update: if isAdmin() &&
        request.resource.data.keys().hasOnly(['nome','imagem']) &&
        request.resource.data.nome is string &&
        request.resource.data.nome.size() >= 2 &&
        request.resource.data.nome.size() <= 70 &&
        request.resource.data.imagem is string &&
        request.resource.data.imagem.size() < 250000;
      allow delete: if isAdmin();
    }
    match /matches/{id} {
      allow read: if true;
      allow create: if canScore() &&
        request.resource.data.id == id &&
        request.resource.data.teamA is list &&
        request.resource.data.teamB is list &&
        request.resource.data.stats is map;
      allow update: if false;
      allow delete: if isAdmin();
    }
    match /active/{id} {
      allow read: if id == 'current';
      allow create, update: if id == 'current' && canScore() &&
        request.resource.data.status in ['setup','live'] &&
        request.resource.data.teamA is list &&
        request.resource.data.teamB is list &&
        request.resource.data.stats is map;
      allow delete: if false;
    }
    match /{path=**} {
      allow read, write: if false;
    }
  }
}
